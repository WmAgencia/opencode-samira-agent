# Port exposed by Railway (optional locally; defaults to 3000)
PORT=3000

# NVIDIA API key - NEVER commit a real value
NVIDIA_API_KEY=

# Service metadata (safe to expose)
SERVICE_NAME=opencode-samira-agent
SERVICE_VERSION=0.1.0

# Log level: trace|debug|info|warn|error|fatal
LOG_LEVEL=info

# Optional agent behavior knobs
AGENT_MODEL=z-ai/glm-5.2
AGENT_MAX_TOKENS=1024

# === Evolution API integration (webhook MVP) ===

# Base URL of your Evolution API instance, including https://
# Use the literal "mock://evolution" to run locally WITHOUT calling a real
# Evolution API (webhook endpoints will accept payloads but sendText becomes
# a no-op that returns a synthetic 200).
EVOLUTION_API_URL=

# API key used in the `apikey` header to call Evolution API endpoints.
# Never commit a real value.
EVOLUTION_API_KEY=

# Name of the WhatsApp instance configured in your Evolution API.
EVOLUTION_INSTANCE_NAME=

# Shared secret required on every incoming webhook call.
# The Evolution API must send it in the `x-webhook-secret` header or in the
# `?secret=` query parameter; otherwise the route returns 401.
WEBHOOK_SECRET=

# Comma-separated list of Evolution events accepted by the webhook.
# Defaults to: messages.upsert,messages.upsert-ephemeral
EVOLUTION_WEBHOOK_EVENTS=messages.upsert,messages.upsert-ephemeral

# How many parallel NVIDIA calls the webhook handler is allowed to make.
# Default 1 serializes calls (recommended while glm-5.2 takes ~30s each).
EVOLUTION_AGENT_CONCURRENCY=1

# === Agent loop + tools ===

# Master switch for tool use. Keep "false" in production unless you
# explicitly activate tool calling for a known use case.
# For availability + admin notifications enable it:
#   AGENT_ENABLE_TOOLS=true
AGENT_ENABLE_TOOLS=false

# Comma-separated permissions allowed at runtime.
# Categories: READ, WRITE, EXECUTE, NETWORK, WHATSAPP
# Default only enables READ; enable others with caution.
# For scheduling/admin features enable:
#   AGENT_ALLOWED_PERMS=READ,NETWORK,WHATSAPP
AGENT_ALLOWED_PERMS=READ

# Optional comma-separated allowlist of tool names. If empty, all
# whitelisted-by-permission tools are exposed to the model.
# Example: file.read,file.write,list.dir
AGENT_ALLOWED_TOOLS=

# Filesystem root for READ/WRITE tools. Defaults to ./workspace
# (created on boot). Use an absolute path or container volume mount
# on Railway. NEVER point at sensitive directories.
AGENT_ALLOWED_DIR=

# Max agent loop iterations per request (1..20). Each iteration is one
# chat.completions round-trip to NVIDIA. 6 is enough for most tasks
# involving a couple of tool calls.
AGENT_MAX_ITERATIONS=6

# Per-tool execution timeout in ms.
AGENT_TOOL_TIMEOUT_MS=15000

# Whether the model advertises support for OpenAI-style function
# calling. Use "auto" (default) to detect on first request and cache,
# "true" to force, "false" to always use plain text (no tools).
AGENT_MODEL_SUPPORTS_TOOLS=auto

# === Persistence (Etapa 2B) ===

# Postgres connection string. When set, conversations and tool runs are
# persisted to tables `conversations`, `messages`, `tool_runs`. When unset,
# the service falls back to in-RAM storage (state lost on restart).
# Examples:
#   postgres://user:password@host:5432/dbname
#   postgresql://...
# Free tier: Neon (https://neon.tech) or Railway Postgres plugin.
DATABASE_URL=

# === Scheduling / availability (agenda do site) ===

# Endpoint on the Samira site that returns already-booked appointments.
# JSON accepted: array of date/time strings, array of objects with
# start/date/time fields, or { "appointments": [...] }.
# When unset, the agent cannot confirm availability and falls back to
# "A Samira vai te atender assim que puder".
# Example: AGENDA_API_URL=https://samirarevela.com.br/api/agendamentos
AGENDA_API_URL=

# WhatsApp group JID notified when a client is left waiting
# (used by notify_admin_group; requires Evolution API configured below).
# Example: AGENT_ADMIN_GROUP_JID=120363123456789@g.us
AGENT_ADMIN_GROUP_JID=

# Endpoint on the Samira site that CREATES a booking
# (POST /api/public/booking). Used by criar_agendamento — the tool the agent
# calls before confirming a reservation. The site persists the booking and
# fires the internal group notification.
# Example: AGENT_BOOKING_API_URL=https://samira-revela-site.lovable.app/api/public/booking
AGENT_BOOKING_API_URL=

# === Public API (site-facing POST /api/chat) ===

# Bearer token the site must send as `Authorization: Bearer <AGENT_API_KEY>`
# on every POST /api/chat call. Lives only server-side (never on the frontend,
# never in logs, never in responses). When unset, /api/chat refuses requests
# with 503 so the model endpoint is never left wide open.
# Generate one with, e.g.:  openssl rand -hex 32
AGENT_API_KEY=

# Comma-separated CORS origin allowlist for the site frontend.
# Browsers may only call the API from these origins; everything else is
# refused on preflight. Use the literal "*" ONLY for local dev.
# Subdomain wildcard supported: "*.lovable.app" matches any *.lovable.app.
# Example:
# ALLOWED_ORIGINS=https://samirarevela.com.br,https://www.samirarevela.com.br
ALLOWED_ORIGINS=
